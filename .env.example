# Database (SQL & MongoDB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=fakenewshub
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/fakenewshub
# MongoDB Atlas
MONGODB_URI="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@truthguardcluster.hc8mrmh.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE="fake_news_deepfake_hub"

# Backend Security
SECRET_KEY=generate_a_secure_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Config
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
PROJECT_NAME="Fake News & Deepfake Detection Hub"

# APIs
FACT_CHECK_API_KEY=your_external_api_key_here
GROK_API_KEY=your_grok_or_xai_api_key_here
XAI_API_KEY=your_grok_or_xai_api_key_here

# ML Config
MODEL_DIR=./models
MAX_VIDEO_DURATION_SECONDS=60
MAX_UPLOAD_SIZE_MB=50
